{
  "name": "@nshiab/journalism-dataviz",
  "version": "1.0.29",
  "description": "Useful TypeScript functions for journalism projects. This library focuses on data visualization.",
  "homepage": "https://nshiab.github.io/journalism-dataviz/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nshiab/journalism-dataviz.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "llm.md",
    "llms.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fix": "vp check --fix",
    "docs": "typedoc && node scripts/docs.ts",
    "all-tests": "vp check && vp test && vp pack && npm run docs",
    "preversion": "node scripts/check-release-branch.ts && npm run all-tests",
    "version": "npm run docs && git add docs llm.md llms.txt",
    "postversion": "git push --atomic origin HEAD \"v$npm_package_version\"",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@observablehq/plot": "^0.6.17",
    "@resvg/resvg-js": "^2.6.2",
    "d3-dsv": "^3.0.1",
    "d3-geo": "^3.1.1",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "24.19.2",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typedoc-plugin-llms-txt": "0.1.2",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "6.0.3",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
